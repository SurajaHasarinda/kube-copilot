# Google Gemini API Key
GOOGLE_API_KEY=your-google-api-key-here

# Kubernetes configuration
# Leave empty to use default kubeconfig (~/.kube/config)
KUBECONFIG_PATH=

# Default namespace to scope the agent to
DEFAULT_NAMESPACE=default

# Gemini model to use
GEMINI_MODEL=gemini-2.0-flash

# PostgreSQL database connection string
POSTGRES_URL=postgresql://user:password@localhost:5432/k8s_autopilot

# ── API Server ───────────────────────────────────────────────────────────────

# Secret key for signing JWT tokens (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=change-me-to-a-random-64-char-hex-string

# JWT token expiry in minutes
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Admin credentials for UI login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-secure-password
# Comma-separated list of allowed CORS origins for the chat UI
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# API server host and port
API_HOST=0.0.0.0
API_PORT=8321

# ── Alert Email Variables ────────────────────────────────────────────────────
SMTP_SERVER=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=alerts@kube-copilot.local
